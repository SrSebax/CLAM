rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Fuente de verdad de autorización: Custom Claim asignado vía scripts/setAdminClaim.mjs
    // (Admin SDK). Nunca se confía en datos de Firestore ni en el cliente para esto.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Valida que el update a un post de un doc de posts solo mueva en +-1 el
    // campo dado (contadores denormalizados de likes/comentarios) y nada más.
    function isSingleFieldStepChange(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && (
          request.resource.data[field] == resource.data[field] + 1 ||
          request.resource.data[field] == resource.data[field] - 1
        );
    }

    // --- posts ---
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, delete: if isAdmin();

      // El admin puede editar cualquier campo. Un usuario autenticado solo puede
      // mover en +-1 los contadores denormalizados (like/comment), y nada más,
      // como resultado de las transacciones de likes.service.ts / comments.service.ts.
      allow update: if isAdmin() || (isSignedIn() && (
        isSingleFieldStepChange('likesCount') || isSingleFieldStepChange('commentsCount')
      ));
    }

    // --- categories ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- comments ---
    match /comments/{commentId} {
      allow read: if resource.data.status == 'visible' || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.status == 'visible'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Moderación (ocultar/mostrar) y borrado: solo administrador.
      allow update, delete: if isAdmin();
    }

    // --- likes ---
    match /likes/{likeId} {
      allow read: if isSignedIn();

      // El id del documento debe ser exactamente "{postId}_{uid}" para que cada
      // usuario solo pueda tener un Like por publicación.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.auth.uid;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // --- settings (configuración pública del sitio: banner, textos de bienvenida) ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- users ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    // Todo lo no contemplado explícitamente queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
