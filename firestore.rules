rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Fuente de verdad de autorización: Custom Claim asignado vía scripts/setAdminClaim.mjs
    // (Admin SDK). Nunca se confía en datos de Firestore ni en el cliente para esto.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Valida que el update a un post de un doc de posts solo mueva en +-1 el
    // campo dado (contadores denormalizados de likes/comentarios) y nada más.
    function isSingleFieldStepChange(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && (
          request.resource.data[field] == resource.data[field] + 1 ||
          request.resource.data[field] == resource.data[field] - 1
        );
    }

    // --- posts ---
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, delete: if isAdmin();

      // El admin puede editar cualquier campo. Cualquier visitante (sin sesión,
      // ver comments/likes más abajo) solo puede mover en +-1 los contadores
      // denormalizados (like/comment), y nada más, como resultado de las
      // transacciones de likes.service.ts / comments.service.ts.
      allow update: if isAdmin() ||
        isSingleFieldStepChange('likesCount') || isSingleFieldStepChange('commentsCount');
    }

    // --- categories ---
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- comments ---
    // Sin cuentas de usuario: cualquier visitante puede comentar dando (o no)
    // un nombre. No hay forma de verificar identidad real; el control de abuso
    // queda en manos del admin vía moderación (ocultar/borrar).
    match /comments/{commentId} {
      allow read: if resource.data.status == 'visible' || isAdmin();

      allow create: if request.resource.data.postId is string
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 80
        && request.resource.data.status == 'visible'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Moderación (ocultar/mostrar) y borrado: solo administrador.
      allow update, delete: if isAdmin();
    }

    // --- likes ---
    // El id del documento es "{postId}_{anonId}", donde anonId es un id random
    // generado en el navegador (localStorage, ver src/composables/useAnonId.ts).
    // Sin cuentas no hay forma de atar el Like a una identidad real; solo se
    // valida la forma del documento y del id determinístico.
    match /likes/{likeId} {
      allow read: if true;

      allow create: if request.resource.data.userId is string
        && likeId == request.resource.data.postId + '_' + request.resource.data.userId;

      allow delete: if resource.data.userId is string;
      allow update: if false;
    }

    // --- settings (configuración pública del sitio: banner, textos de bienvenida) ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo lo no contemplado explícitamente queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
